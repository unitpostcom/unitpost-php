{
  "name": "unitpost/unitpost",
  "description": "Official Unitpost SDK for PHP — send email and manage contacts, segments, campaigns, templates, domains, webhooks, and suppressions.",
  "type": "library",
  "license": "MIT",
  "version": "0.3.0",
  "homepage": "https://www.unitpost.com/docs",
  "support": {
    "issues": "https://github.com/unitpostcom/unitpost-php/issues",
    "source": "https://github.com/unitpostcom/unitpost-php"
  },
  "require": {
    "php": ">=8.2",
    "ext-json": "*",
    "ext-curl": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": { "Unitpost\\": "src/" },
    "classmap": ["src/Resources.php", "src/Result.php"],
    "files": ["src/Webhooks.php"]
  },
  "autoload-dev": {
    "psr-4": { "Unitpost\\Tests\\": "tests/" }
  },
  "minimum-stability": "stable"
}
